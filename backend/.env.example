# === OBLIGATOIRES ===
PORT=3000

# Chaîne aléatoire longue et secrète (min 16 caractères)
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue_et_secrete

# Base PostgreSQL (Neon.tech, Render, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email du compte administrateur (doit correspondre à ADMIN_EMAIL dans auth.js frontend)
ADMIN_EMAIL=admin@example.com

# Mot de passe initial de l'admin (min 8 caractères) — créé automatiquement au démarrage
ADMIN_INITIAL_PASSWORD=

# === OPTIONNELLES ===
# Origines autorisées pour le CORS, séparées par des virgules.
# Non définie → ouvert à tous (*). Recommandé en production :
# ALLOWED_ORIGINS=https://jeaneveillard.github.io
ALLOWED_ORIGINS=

# === CLÉS API IA ===
# Pollinations alimente le mode « sans compte » (route publique /api/diagnose/free).
# Depuis la fin de l’accès anonyme, une clé est obligatoire — gratuite, sans carte
# bancaire : https://enter.pollinations.ai/keys
# Sans cette clé, le mode gratuit répond 503 avec un message clair.
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
